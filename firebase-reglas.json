{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "eventos": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "flyers": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "ocupacion": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$ev": {
        "$pid": {
          ".write": "!data.exists() && newData.exists() && !root.child('pedidos').child($pid).exists() && newData.parent().parent().parent().child('pedidos/' + $pid + '/ev').val() === $ev && newData.parent().parent().parent().child('pedidos/' + $pid + '/tipo').val() === newData.child('t').val() && newData.parent().parent().parent().child('pedidos/' + $pid + '/cant').val() === newData.child('n').val() && ((newData.child('e').val() === 'p' && newData.parent().parent().parent().child('pedidos/' + $pid + '/estado').val() === 'pendiente' && newData.child('x').val() === newData.parent().parent().parent().child('pedidos/' + $pid + '/expira').val()) || (newData.child('e').val() === 'a' && newData.parent().parent().parent().child('pedidos/' + $pid + '/estado').val() === 'aprobada' && newData.parent().parent().parent().child('pedidos/' + $pid + '/total').val() === 0))"
        }
      }
    },

    "pedidos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["estado", "ev", "expira"],
      "$pid": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['codigo', 'ev', 'tipo', 'cant', 'total', 'nombre', 'estado', 'creado', 'expira'])",
        "estado": {
          ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (root.child('eventos/' + newData.parent().child('ev').val() + '/publicado').val() === true && (newData.val() === 'pendiente' || (newData.val() === 'aprobada' && newData.parent().child('total').val() === 0)))"
        },
        "cant": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
        },
        "total": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('admins').child(auth.uid).val() === true) || newData.val() === root.child('eventos/' + newData.parent().child('ev').val() + '/tipos/' + newData.parent().child('tipo').val() + '/precio').val() * newData.parent().child('cant').val())"
        },
        "entradas": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('admins').child(auth.uid).val() === true) || newData.val() === newData.parent().child('cant').val() * root.child('eventos/' + newData.parent().child('ev').val() + '/tipos/' + newData.parent().child('tipo').val() + '/personas').val() || (!root.child('eventos/' + newData.parent().child('ev').val() + '/tipos/' + newData.parent().child('tipo').val() + '/personas').exists() && newData.val() === newData.parent().child('cant').val()))"
        },
        "creado": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('admins').child(auth.uid).val() === true) || newData.val() === now)"
        },
        "expira": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('admins').child(auth.uid).val() === true) || newData.val() <= now + 3720000)"
        },
        "usadas": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('admins').child(auth.uid).val() === true) || newData.val() === 0)"
        },
        "aprobado": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "cortesia": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    },

    "pagos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["estado", "recibido"]
    }
  }
}
